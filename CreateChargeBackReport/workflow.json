{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "description": "Trigger generation of report daily",
        "recurrence": {
          "interval": 24,
          "frequency": "Hour",
          "timeZone": "Central Standard Time"
        }
      }
    },
    "actions": {
      "Initialize_Time_Chunks": {
        "type": "InitializeVariable",
        "description": "Create 12 x 2-hour time chunks. Each chunk outputs to its own blob.",
        "inputs": {
          "variables": [
            {
              "name": "TimeChunks",
              "type": "array",
              "value": [
                { "chunkId": 1, "hoursAgo": 24, "hoursUntil": 22, "blobName": "chargeBack-chunk-01-21h-23h.csv" },
                { "chunkId": 2, "hoursAgo": 22, "hoursUntil": 20, "blobName": "chargeBack-chunk-02-23h-01h.csv" },
                { "chunkId": 3, "hoursAgo": 20, "hoursUntil": 18, "blobName": "chargeBack-chunk-03-01h-03h.csv" },
                { "chunkId": 4, "hoursAgo": 18, "hoursUntil": 16, "blobName": "chargeBack-chunk-04-03h-05h.csv" },
                { "chunkId": 5, "hoursAgo": 16, "hoursUntil": 14, "blobName": "chargeBack-chunk-05-05h-07h.csv" },
                { "chunkId": 6, "hoursAgo": 14, "hoursUntil": 12, "blobName": "chargeBack-chunk-06-07h-09h.csv" },
                { "chunkId": 7, "hoursAgo": 12, "hoursUntil": 10, "blobName": "chargeBack-chunk-07-09h-11h.csv" },
                { "chunkId": 8, "hoursAgo": 10, "hoursUntil": 8, "blobName": "chargeBack-chunk-08-11h-13h.csv" },
                { "chunkId": 9, "hoursAgo": 8, "hoursUntil": 6, "blobName": "chargeBack-chunk-09-13h-15h.csv" },
                { "chunkId": 10, "hoursAgo": 6, "hoursUntil": 4, "blobName": "chargeBack-chunk-10-15h-17h.csv" },
                { "chunkId": 11, "hoursAgo": 4, "hoursUntil": 2, "blobName": "chargeBack-chunk-11-17h-19h.csv" },
                { "chunkId": 12, "hoursAgo": 2, "hoursUntil": 0, "blobName": "chargeBack-chunk-12-19h-21h.csv" }
              ]
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_Report_Date": {
        "type": "InitializeVariable",
        "description": "Initialize the report date (yesterday) for filtering Log Analytics data and naming the daily blob.",
        "inputs": {
          "variables": [
            {
              "name": "ReportDate",
              "type": "string",
              "value": "@{formatDateTime(subtractFromTime(utcNow(), 1, 'Day'), 'yyyy-MM-dd')}"
            }
          ]
        },
        "runAfter": {
          "Initialize_Time_Chunks": [
            "Succeeded"
          ]
        }
      },
      "Initialize_Workflow_Run_Id": {
        "type": "InitializeVariable",
        "description": "Capture this run's unique ID. Written into every chunk row in ChargeBackChunks_CL so the final summary query can isolate exactly this run's data, preventing duplication from re-runs on the same day.",
        "inputs": {
          "variables": [
            {
              "name": "WorkflowRunId",
              "type": "string",
              "value": "@{workflow().run.id}"
            }
          ]
        },
        "runAfter": {
          "Initialize_Report_Date": [
            "Succeeded"
          ]
        }
      },
      "Initialize_Expected_Chunk_Count": {
        "type": "InitializeVariable",
        "description": "Counts how many chunks actually had data and wrote to ChargeBackChunks_CL. Used by the ingestion polling loop to know when all written chunks have been ingested.",
        "inputs": {
          "variables": [
            {
              "name": "ExpectedChunkCount",
              "type": "integer",
              "value": 0
            }
          ]
        },
        "runAfter": {
          "Initialize_Workflow_Run_Id": [
            "Succeeded"
          ]
        }
      },
      "Process_Time_Chunks": {
        "type": "Foreach",
        "description": "Process each 2-hour chunk: query Log Analytics, transform rows, enrich with run metadata, and write to ChargeBackChunks_CL via the Logs Ingestion API.",
        "foreach": "@variables('TimeChunks')",
        "actions": {
          "Submit_Chunk_Query": {
            "type": "Http",
            "description": "Submit the Log Analytics query for this time chunk.",
            "inputs": {
              "uri": "https://api.loganalytics.io/v1/workspaces/@{appsetting('LOG_ANALYTICS_WORKSPACE_ID')}/query",
              "method": "POST",
              "headers": {
                "Content-Type": "application/json",
                "Prefer": "wait=0"
              },
              "body": {
                "query": "let reportEnd = datetime_add('hour', @{int(appsetting('REPORT_END_HOUR'))}, startofday(now())); let chunkStart = datetime_add('hour', -@{items('Process_Time_Chunks')['hoursAgo']}, reportEnd); let chunkEnd = datetime_add('hour', -@{items('Process_Time_Chunks')['hoursUntil']}, reportEnd); let llmAgg = ApiManagementGatewayLlmLog | where TimeGenerated >= chunkStart and TimeGenerated < chunkEnd | where SequenceNumber == 0 | summarize TotalTokens = sum(TotalTokens), CompletionTokens = sum(CompletionTokens), PromptTokens = sum(PromptTokens) by CorrelationId; ApiManagementGatewayLogs | where TimeGenerated >= chunkStart and TimeGenerated < chunkEnd | where IsRequestSuccess | join hint.strategy=shuffle kind=inner llmAgg on CorrelationId | extend ParsedUrl = parse_url(BackendUrl) | extend ExtractedEndpoint = strcat(tostring(ParsedUrl.Scheme), '://', tostring(ParsedUrl.Host), '/') | extend DeploymentFromUrl = extract('/openai/deployments/([^/]+)/', 1, BackendUrl) | extend Luma = extract('^([0-9]{6})', 1, ApimSubscriptionId), Workspace = extract('^[0-9]{6}-(.+)$', 1, ApimSubscriptionId) | join kind=leftouter (CognitiveServicesInventory_CL | summarize arg_max(TimeGenerated, *) by AccountEndpoint, DeploymentName | project AccountEndpoint, CogSvcDeploymentName = DeploymentName, CogSvcModelName = ModelName, CogSvcSkuName = SkuName, CogSvcSkuCapacity = SkuCapacity, CogSvcAccountName = AccountName, CogSvcSubscriptionId = SubscriptionId, CogSvcAccountId = AccountId) on $left.ExtractedEndpoint == $right.AccountEndpoint, $left.DeploymentFromUrl == $right.CogSvcDeploymentName | summarize TotalTokens = sum(TotalTokens), CompletionTokens = sum(CompletionTokens), PromptTokens = sum(PromptTokens), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Regions = strcat_array(make_set(Region, 8), '; '), CallerIpAddresses = strcat_array(make_set(CallerIpAddress, 8), '; '), Calls = count() by ProductId, DeploymentFromUrl, ExtractedEndpoint, BackendId, CogSvcModelName, CogSvcSkuName, CogSvcSkuCapacity, CogSvcAccountName, CogSvcSubscriptionId, CogSvcAccountId, Luma, Workspace | project ProductId, Luma, Workspace, DeploymentName = DeploymentFromUrl, ModelName = CogSvcModelName, AccountName = CogSvcAccountName, SubscriptionId = CogSvcSubscriptionId, ResourceID = CogSvcAccountId, SkuName = CogSvcSkuName, SkuCapacity = CogSvcSkuCapacity, BackendId, Endpoint = ExtractedEndpoint, PromptTokens, CompletionTokens, TotalTokens, Calls, FirstSeen, LastSeen, Regions, CallerIpAddresses | order by ProductId asc, TotalTokens desc"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
                "audience": "https://api.loganalytics.io"
              }
            },
            "runAfter": {},
            "runtimeConfiguration": {
              "contentTransfer": {
                "transferMode": "Chunked"
              }
            }
          },
          "Check_Chunk_Sync_Or_Async": {
            "type": "If",
            "description": "If 200, query completed synchronously. If 202, poll for results.",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@outputs('Submit_Chunk_Query')['statusCode']",
                    200
                  ]
                }
              ]
            },
            "actions": {
              "Set_Chunk_Sync_Results": {
                "type": "Compose",
                "inputs": "@body('Submit_Chunk_Query')"
              }
            },
            "else": {
              "actions": {
                "Get_Poll_Location": {
                  "type": "Compose",
                  "inputs": "@outputs('Submit_Chunk_Query')['headers']?['location']",
                  "runAfter": {}
                },
                "Wait_Before_Poll": {
                  "type": "Wait",
                  "inputs": {
                    "interval": {
                      "count": 10,
                      "unit": "Second"
                    }
                  },
                  "runAfter": {
                    "Get_Poll_Location": [
                      "Succeeded"
                    ]
                  }
                },
                "Poll_Chunk_Results": {
                  "type": "Until",
                  "expression": "@not(equals(outputs('Check_Chunk_Status')['statusCode'], 202))",
                  "limit": {
                    "count": 60,
                    "timeout": "PT10M"
                  },
                  "actions": {
                    "Check_Chunk_Status": {
                      "type": "Http",
                      "inputs": {
                        "uri": "@outputs('Get_Poll_Location')",
                        "method": "GET",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
                          "audience": "https://api.loganalytics.io"
                        }
                      },
                      "runAfter": {}
                    },
                    "Delay_Chunk_Poll": {
                      "type": "Wait",
                      "inputs": {
                        "interval": {
                          "count": 5,
                          "unit": "Second"
                        }
                      },
                      "runAfter": {
                        "Check_Chunk_Status": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Wait_Before_Poll": [
                      "Succeeded"
                    ]
                  }
                },
                "Set_Chunk_Async_Results": {
                  "type": "Compose",
                  "inputs": "@body('Check_Chunk_Status')",
                  "runAfter": {
                    "Poll_Chunk_Results": [
                      "Succeeded"
                    ]
                  }
                }
              }
            },
            "runAfter": {
              "Submit_Chunk_Query": [
                "Succeeded"
              ]
            }
          },
          "Get_Chunk_Results": {
            "type": "Compose",
            "description": "Get the final query results (from sync or async path).",
            "inputs": "@if(equals(outputs('Submit_Chunk_Query')['statusCode'], 200), outputs('Set_Chunk_Sync_Results'), outputs('Set_Chunk_Async_Results'))",
            "runAfter": {
              "Check_Chunk_Sync_Or_Async": [
                "Succeeded"
              ]
            }
          },
          "Transform_Chunk_To_Objects": {
            "type": "Select",
            "description": "Transform each row array to a named object.",
            "inputs": {
              "from": "@if(equals(outputs('Get_Chunk_Results')?['tables']?[0]?['rows'], null), json('[]'), outputs('Get_Chunk_Results')?['tables']?[0]?['rows'])",
              "select": {
                "ProductId": "@item()[0]",
                "Luma": "@item()[1]",
                "Workspace": "@item()[2]",
                "DeploymentName": "@item()[3]",
                "ModelName": "@item()[4]",
                "AccountName": "@item()[5]",
                "SubscriptionId": "@item()[6]",
                "ResourceID": "@item()[7]",
                "SkuName": "@item()[8]",
                "SkuCapacity": "@item()[9]",
                "BackendId": "@item()[10]",
                "Endpoint": "@item()[11]",
                "PromptTokens": "@item()[12]",
                "CompletionTokens": "@item()[13]",
                "TotalTokens": "@item()[14]",
                "Calls": "@item()[15]",
                "FirstSeen": "@item()[16]",
                "LastSeen": "@item()[17]",
                "Regions": "@item()[18]",
                "CallerIpAddresses": "@item()[19]"
              }
            },
            "runAfter": {
              "Get_Chunk_Results": [
                "Succeeded"
              ]
            }
          },
          "Enrich_Chunk_Rows": {
            "type": "Select",
            "description": "Add ReportDate, WorkflowRunId, ChunkId, and TimeGenerated to every row before writing to ChargeBackChunks_CL.",
            "inputs": {
              "from": "@body('Transform_Chunk_To_Objects')",
              "select": {
                "TimeGenerated": "@{utcNow()}",
                "ReportDate": "@{variables('ReportDate')}",
                "WorkflowRunId": "@{variables('WorkflowRunId')}",
                "ChunkId": "@{items('Process_Time_Chunks')['chunkId']}",
                "ProductId": "@item()['ProductId']",
                "Luma": "@item()['Luma']",
                "Workspace": "@item()['Workspace']",
                "DeploymentName": "@item()['DeploymentName']",
                "ModelName": "@item()['ModelName']",
                "AccountName": "@item()['AccountName']",
                "SubscriptionId": "@item()['SubscriptionId']",
                "ResourceID": "@item()['ResourceID']",
                "SkuName": "@item()['SkuName']",
                "SkuCapacity": "@item()['SkuCapacity']",
                "BackendId": "@item()['BackendId']",
                "Endpoint": "@item()['Endpoint']",
                "PromptTokens": "@item()['PromptTokens']",
                "CompletionTokens": "@item()['CompletionTokens']",
                "TotalTokens": "@item()['TotalTokens']",
                "Calls": "@item()['Calls']",
                "FirstSeen": "@item()['FirstSeen']",
                "LastSeen": "@item()['LastSeen']",
                "Regions": "@item()['Regions']",
                "CallerIpAddresses": "@item()['CallerIpAddresses']"
              }
            },
            "runAfter": {
              "Transform_Chunk_To_Objects": [
                "Succeeded"
              ]
            }
          },
          "Write_Chunk_To_Logs_If_Has_Rows": {
            "type": "If",
            "description": "Only POST to Log Analytics if this chunk has rows. The Logs Ingestion API returns 400 for empty arrays.",
            "expression": {
              "and": [
                {
                  "greater": [
                    "@length(body('Enrich_Chunk_Rows'))",
                    0
                  ]
                }
              ]
            },
            "actions": {
              "Write_Chunk_To_Logs": {
                "type": "Http",
                "description": "POST this chunk's enriched rows to ChargeBackChunks_CL via the Logs Ingestion API. Tagged with WorkflowRunId to enable idempotent daily re-aggregation.",
                "inputs": {
                  "uri": "https://dce-chargeback-tvn4e57jpmg4q-5h4y.eastus2-1.ingest.monitor.azure.com/dataCollectionRules/dcr-829cd683f0bf4bb8b98044ed97e7b578/streams/Custom-ChargeBackChunksStream?api-version=2023-01-01",
                  "method": "POST",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": "@body('Enrich_Chunk_Rows')",
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
                    "audience": "https://monitor.azure.com"
                  }
                },
                "runAfter": {}
              },
              "Increment_Expected_Chunk_Count": {
                "type": "IncrementVariable",
                "description": "Track that this chunk successfully wrote to ChargeBackChunks_CL, so the ingestion poll knows the exact target count.",
                "inputs": {
                  "name": "ExpectedChunkCount",
                  "value": 1
                },
                "runAfter": {
                  "Write_Chunk_To_Logs": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Enrich_Chunk_Rows": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_Expected_Chunk_Count": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        }
      },
      "Wait_Before_Ingestion_Poll": {
        "type": "Wait",
        "description": "Initial 30-second pause before starting ingestion polling. Gives the Logs Ingestion API a head start before the first count check.",
        "inputs": {
          "interval": {
            "count": 30,
            "unit": "Second"
          }
        },
        "runAfter": {
          "Process_Time_Chunks": [
            "Succeeded"
          ]
        }
      },
      "Poll_For_Ingestion": {
        "type": "Until",
        "description": "Poll ChargeBackChunks_CL every 30 seconds until the number of distinct ingested ChunkIds matches ExpectedChunkCount. Exits immediately if ExpectedChunkCount is 0 (all chunks were empty). Times out after 20 minutes.",
        "expression": "@greaterOrEquals(coalesce(body('Check_Ingestion_Count')?['tables']?[0]?['rows']?[0]?[0], 0), variables('ExpectedChunkCount'))",
        "limit": {
          "count": 40,
          "timeout": "PT20M"
        },
        "actions": {
          "Check_Ingestion_Count": {
            "type": "Http",
            "description": "Query ChargeBackChunks_CL for the count of distinct ChunkIds written by this run. Uses isfuzzy=true in case the table is not yet queryable.",
            "inputs": {
              "uri": "https://api.loganalytics.io/v1/workspaces/@{appsetting('ERROR_WORKSPACE_ID')}/query",
              "method": "POST",
              "headers": {
                "Content-Type": "application/json",
                "Prefer": "wait=600"
              },
              "body": {
                "query": "union isfuzzy=true ChargeBackChunks_CL | where WorkflowRunId == '@{variables('WorkflowRunId')}' | summarize IngestedChunks = dcount(ChunkId)"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
                "audience": "https://api.loganalytics.io"
              }
            },
            "runAfter": {}
          },
          "Delay_Ingestion_Poll": {
            "type": "Wait",
            "description": "Wait 30 seconds before the next ingestion count check.",
            "inputs": {
              "interval": {
                "count": 30,
                "unit": "Second"
              }
            },
            "runAfter": {
              "Check_Ingestion_Count": [
                "Succeeded",
                "Failed"
              ]
            }
          }
        },
        "runAfter": {
          "Wait_Before_Ingestion_Poll": [
            "Succeeded"
          ]
        }
      },
      "Submit_Daily_Query": {
        "type": "Http",
        "description": "Re-aggregate this run's 12 chunk summaries from ChargeBackChunks_CL into a single daily total per ProductId + Deployment. Filtered by WorkflowRunId to prevent duplication if the workflow is re-run on the same day.",
        "inputs": {
          "uri": "https://api.loganalytics.io/v1/workspaces/@{appsetting('ERROR_WORKSPACE_ID')}/query",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "Prefer": "wait=0"
          },
          "body": {
            "query": "let runId = '@{variables('WorkflowRunId')}'; let reportDate = '@{variables('ReportDate')}'; union isfuzzy=true ChargeBackChunks_CL | where ReportDate == reportDate and WorkflowRunId == runId | summarize TotalTokens = sum(TotalTokens), CompletionTokens = sum(CompletionTokens), PromptTokens = sum(PromptTokens), FirstSeen = min(FirstSeen), LastSeen = max(LastSeen), Regions = strcat_array(make_set(Regions), '; '), CallerIpAddresses = strcat_array(make_set(CallerIpAddresses), '; '), Calls = sum(Calls) by ProductId, Luma, Workspace, DeploymentName, ModelName, AccountName, SubscriptionId, ResourceID, SkuName, SkuCapacity, BackendId, Endpoint | project ProductId, Luma, Workspace, DeploymentName, ModelName, AccountName, SubscriptionId, ResourceID, SkuName, SkuCapacity, BackendId, Endpoint, PromptTokens, CompletionTokens, TotalTokens, Calls, FirstSeen, LastSeen, Regions, CallerIpAddresses | order by ProductId asc, TotalTokens desc"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
            "audience": "https://api.loganalytics.io"
          }
        },
        "runAfter": {
          "Poll_For_Ingestion": [
            "Succeeded",
            "TimedOut"
          ]
        },
        "runtimeConfiguration": {
          "contentTransfer": {
            "transferMode": "Chunked"
          }
        }
      },
      "Check_Daily_Sync_Or_Async": {
        "type": "If",
        "description": "If 200, daily summary query completed synchronously. If 202, poll for results.",
        "expression": {
          "and": [
            {
              "equals": [
                "@outputs('Submit_Daily_Query')['statusCode']",
                200
              ]
            }
          ]
        },
        "actions": {
          "Set_Daily_Sync_Results": {
            "type": "Compose",
            "inputs": "@body('Submit_Daily_Query')"
          }
        },
        "else": {
          "actions": {
            "Get_Daily_Poll_Location": {
              "type": "Compose",
              "inputs": "@outputs('Submit_Daily_Query')['headers']?['location']",
              "runAfter": {}
            },
            "Wait_Before_Daily_Poll": {
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 10,
                  "unit": "Second"
                }
              },
              "runAfter": {
                "Get_Daily_Poll_Location": [
                  "Succeeded"
                ]
              }
            },
            "Poll_Daily_Results": {
              "type": "Until",
              "expression": "@not(equals(outputs('Check_Daily_Status')['statusCode'], 202))",
              "limit": {
                "count": 60,
                "timeout": "PT10M"
              },
              "actions": {
                "Check_Daily_Status": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@outputs('Get_Daily_Poll_Location')",
                    "method": "GET",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
                      "audience": "https://api.loganalytics.io"
                    }
                  },
                  "runAfter": {}
                },
                "Delay_Daily_Poll": {
                  "type": "Wait",
                  "inputs": {
                    "interval": {
                      "count": 5,
                      "unit": "Second"
                    }
                  },
                  "runAfter": {
                    "Check_Daily_Status": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Wait_Before_Daily_Poll": [
                  "Succeeded"
                ]
              }
            },
            "Set_Daily_Async_Results": {
              "type": "Compose",
              "inputs": "@body('Check_Daily_Status')",
              "runAfter": {
                "Poll_Daily_Results": [
                  "Succeeded"
                ]
              }
            }
          }
        },
        "runAfter": {
          "Submit_Daily_Query": [
            "Succeeded"
          ]
        }
      },
      "Get_Daily_Results": {
        "type": "Compose",
        "description": "Get the final daily summary query results (from sync or async path).",
        "inputs": "@if(equals(outputs('Submit_Daily_Query')['statusCode'], 200), outputs('Set_Daily_Sync_Results'), outputs('Set_Daily_Async_Results'))",
        "runAfter": {
          "Check_Daily_Sync_Or_Async": [
            "Succeeded"
          ]
        }
      },
      "Transform_Daily_To_Objects": {
        "type": "Select",
        "description": "Transform the re-aggregated daily summary rows into named objects for CSV output.",
        "inputs": {
          "from": "@if(equals(outputs('Get_Daily_Results')?['tables']?[0]?['rows'], null), json('[]'), outputs('Get_Daily_Results')?['tables']?[0]?['rows'])",
          "select": {
            "ProductId": "@item()[0]",
            "Luma": "@item()[1]",
            "Workspace": "@item()[2]",
            "DeploymentName": "@item()[3]",
            "ModelName": "@item()[4]",
            "AccountName": "@item()[5]",
            "SubscriptionId": "@item()[6]",
            "ResourceID": "@item()[7]",
            "SkuName": "@item()[8]",
            "SkuCapacity": "@item()[9]",
            "BackendId": "@item()[10]",
            "Endpoint": "@item()[11]",
            "PromptTokens": "@item()[12]",
            "CompletionTokens": "@item()[13]",
            "TotalTokens": "@item()[14]",
            "Calls": "@item()[15]",
            "FirstSeen": "@item()[16]",
            "LastSeen": "@item()[17]",
            "Regions": "@item()[18]",
            "CallerIpAddresses": "@item()[19]"
          }
        },
        "runAfter": {
