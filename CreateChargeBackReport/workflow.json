{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "description": "Trigger generation of report daily",
        "recurrence": {
          "interval": 24,
          "frequency": "Hour",
          "timeZone": "Central Standard Time"
        }
      }
    },
    "actions": {
      "Initialize_Time_Chunks": {
        "type": "InitializeVariable",
        "description": "Create 12 x 2-hour time chunks. Each chunk outputs to its own blob.",
        "inputs": {
          "variables": [
            {
              "name": "TimeChunks",
              "type": "array",
              "value": [
                { "chunkId": 1, "hoursAgo": 24, "hoursUntil": 22, "blobName": "chargeBack-chunk-01-21h-23h.csv" },
                { "chunkId": 2, "hoursAgo": 22, "hoursUntil": 20, "blobName": "chargeBack-chunk-02-23h-01h.csv" },
                { "chunkId": 3, "hoursAgo": 20, "hoursUntil": 18, "blobName": "chargeBack-chunk-03-01h-03h.csv" },
                { "chunkId": 4, "hoursAgo": 18, "hoursUntil": 16, "blobName": "chargeBack-chunk-04-03h-05h.csv" },
                { "chunkId": 5, "hoursAgo": 16, "hoursUntil": 14, "blobName": "chargeBack-chunk-05-05h-07h.csv" },
                { "chunkId": 6, "hoursAgo": 14, "hoursUntil": 12, "blobName": "chargeBack-chunk-06-07h-09h.csv" },
                { "chunkId": 7, "hoursAgo": 12, "hoursUntil": 10, "blobName": "chargeBack-chunk-07-09h-11h.csv" },
                { "chunkId": 8, "hoursAgo": 10, "hoursUntil": 8, "blobName": "chargeBack-chunk-08-11h-13h.csv" },
                { "chunkId": 9, "hoursAgo": 8, "hoursUntil": 6, "blobName": "chargeBack-chunk-09-13h-15h.csv" },
                { "chunkId": 10, "hoursAgo": 6, "hoursUntil": 4, "blobName": "chargeBack-chunk-10-15h-17h.csv" },
                { "chunkId": 11, "hoursAgo": 4, "hoursUntil": 2, "blobName": "chargeBack-chunk-11-17h-19h.csv" },
                { "chunkId": 12, "hoursAgo": 2, "hoursUntil": 0, "blobName": "chargeBack-chunk-12-19h-21h.csv" }
              ]
            }
          ]
        },
        "runAfter": {}
      },
      "Process_Time_Chunks": {
        "type": "Foreach",
        "description": "Process each 2-hour chunk: query, transform, create CSV, write blob.",
        "foreach": "@variables('TimeChunks')",
        "actions": {
          "Submit_Chunk_Query": {
            "type": "Http",
            "description": "Submit the Log Analytics query for this time chunk.",
            "inputs": {
              "uri": "https://api.loganalytics.io/v1/workspaces/@{appsetting('LOG_ANALYTICS_WORKSPACE_ID')}/query",
              "method": "POST",
              "headers": {
                "Content-Type": "application/json",
                "Prefer": "wait=0"
              },
              "body": {
                "query": "let reportEnd = datetime_add('hour', @{int(appsetting('REPORT_END_HOUR'))}, startofday(now() - 1d)); let chunkStart = datetime_add('hour', -@{items('Process_Time_Chunks')['hoursAgo']}, reportEnd); let chunkEnd = datetime_add('hour', -@{items('Process_Time_Chunks')['hoursUntil']}, reportEnd); let llmAgg = ApiManagementGatewayLlmLog | where TimeGenerated >= chunkStart and TimeGenerated < chunkEnd | where SequenceNumber == 0 | summarize TotalTokens = sum(TotalTokens), CompletionTokens = sum(CompletionTokens), PromptTokens = sum(PromptTokens) by CorrelationId; ApiManagementGatewayLogs | where TimeGenerated >= chunkStart and TimeGenerated < chunkEnd | where IsRequestSuccess | join hint.strategy=shuffle kind=inner llmAgg on CorrelationId | extend ParsedUrl = parse_url(BackendUrl) | extend ExtractedEndpoint = strcat(tostring(ParsedUrl.Scheme), '://', tostring(ParsedUrl.Host), '/') | extend DeploymentFromUrl = extract('/openai/deployments/([^/]+)/', 1, BackendUrl) | extend Luma = extract('^([0-9]{6})', 1, ApimSubscriptionId), Workspace = extract('^[0-9]{6}-(.+)$', 1, ApimSubscriptionId) | join kind=leftouter (CognitiveServicesInventory_CL | summarize arg_max(TimeGenerated, *) by AccountEndpoint, DeploymentName | project AccountEndpoint, CogSvcDeploymentName = DeploymentName, CogSvcModelName = ModelName, CogSvcSkuName = SkuName, CogSvcSkuCapacity = SkuCapacity, CogSvcAccountName = AccountName, CogSvcSubscriptionId = SubscriptionId, CogSvcAccountId = AccountId) on $left.ExtractedEndpoint == $right.AccountEndpoint, $left.DeploymentFromUrl == $right.CogSvcDeploymentName | summarize TotalTokens = sum(TotalTokens), CompletionTokens = sum(CompletionTokens), PromptTokens = sum(PromptTokens), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Regions = strcat_array(make_set(Region, 8), '; '), CallerIpAddresses = strcat_array(make_set(CallerIpAddress, 8), '; '), Calls = count() by ProductId, DeploymentFromUrl, ExtractedEndpoint, BackendId, CogSvcModelName, CogSvcSkuName, CogSvcSkuCapacity, CogSvcAccountName, CogSvcSubscriptionId, CogSvcAccountId, Luma, Workspace | project ProductId, Luma, Workspace, DeploymentName = DeploymentFromUrl, ModelName = CogSvcModelName, AccountName = CogSvcAccountName, SubscriptionId = CogSvcSubscriptionId, ResourceID = CogSvcAccountId, SkuName = CogSvcSkuName, SkuCapacity = CogSvcSkuCapacity, BackendId, Endpoint = ExtractedEndpoint, PromptTokens, CompletionTokens, TotalTokens, Calls, FirstSeen, LastSeen, Regions, CallerIpAddresses | order by ProductId asc, TotalTokens desc"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
                "audience": "https://api.loganalytics.io"
              }
            },
            "runAfter": {},
            "runtimeConfiguration": {
              "contentTransfer": {
                "transferMode": "Chunked"
              }
            }
          },
          "Check_Chunk_Sync_Or_Async": {
            "type": "If",
            "description": "If 200, query completed synchronously. If 202, poll for results.",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@outputs('Submit_Chunk_Query')['statusCode']",
                    200
                  ]
                }
              ]
            },
            "actions": {
              "Set_Chunk_Sync_Results": {
                "type": "Compose",
                "inputs": "@body('Submit_Chunk_Query')"
              }
            },
            "else": {
              "actions": {
                "Get_Poll_Location": {
                  "type": "Compose",
                  "inputs": "@outputs('Submit_Chunk_Query')['headers']?['location']",
                  "runAfter": {}
                },
                "Wait_Before_Poll": {
                  "type": "Wait",
                  "inputs": {
                    "interval": {
                      "count": 10,
                      "unit": "Second"
                    }
                  },
                  "runAfter": {
                    "Get_Poll_Location": [
                      "Succeeded"
                    ]
                  }
                },
                "Poll_Chunk_Results": {
                  "type": "Until",
                  "expression": "@not(equals(outputs('Check_Chunk_Status')['statusCode'], 202))",
                  "limit": {
                    "count": 60,
                    "timeout": "PT10M"
                  },
                  "actions": {
                    "Check_Chunk_Status": {
                      "type": "Http",
                      "inputs": {
                        "uri": "@outputs('Get_Poll_Location')",
                        "method": "GET",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
                          "audience": "https://api.loganalytics.io"
                        }
                      },
                      "runAfter": {}
                    },
                    "Delay_Chunk_Poll": {
                      "type": "Wait",
                      "inputs": {
                        "interval": {
                          "count": 5,
                          "unit": "Second"
                        }
                      },
                      "runAfter": {
                        "Check_Chunk_Status": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Wait_Before_Poll": [
                      "Succeeded"
                    ]
                  }
                },
                "Set_Chunk_Async_Results": {
                  "type": "Compose",
                  "inputs": "@body('Check_Chunk_Status')",
                  "runAfter": {
                    "Poll_Chunk_Results": [
                      "Succeeded"
                    ]
                  }
                }
              }
            },
            "runAfter": {
              "Submit_Chunk_Query": [
                "Succeeded"
              ]
            }
          },
          "Get_Chunk_Results": {
            "type": "Compose",
            "description": "Get the final query results (from sync or async path).",
            "inputs": "@if(equals(outputs('Submit_Chunk_Query')['statusCode'], 200), outputs('Set_Chunk_Sync_Results'), outputs('Set_Chunk_Async_Results'))",
            "runAfter": {
              "Check_Chunk_Sync_Or_Async": [
                "Succeeded"
              ]
            }
          },
          "Transform_Chunk_To_Objects": {
            "type": "Select",
            "description": "Transform each row array to a named object.",
            "inputs": {
              "from": "@if(equals(outputs('Get_Chunk_Results')?['tables']?[0]?['rows'], null), json('[]'), outputs('Get_Chunk_Results')?['tables']?[0]?['rows'])",
              "select": {
                "ProductId": "@item()[0]",
                "Luma": "@item()[1]",
                "Workspace": "@item()[2]",
                "DeploymentName": "@item()[3]",
                "ModelName": "@item()[4]",
                "AccountName": "@item()[5]",
                "SubscriptionId": "@item()[6]",
                "SkuName": "@item()[7]",
                "SkuCapacity": "@item()[8]",
                "BackendId": "@item()[9]",
                "Endpoint": "@item()[10]",
                "PromptTokens": "@item()[11]",
                "CompletionTokens": "@item()[12]",
                "TotalTokens": "@item()[13]",
                "Calls": "@item()[14]",
                "FirstSeen": "@item()[15]",
                "LastSeen": "@item()[16]",
                "Regions": "@item()[17]",
                "CallerIpAddresses": "@item()[18]"
              }
            },
            "runAfter": {
              "Get_Chunk_Results": [
                "Succeeded"
              ]
            }
          },
          "Create_Chunk_CSV": {
            "type": "Table",
            "description": "Create CSV from this chunk's data.",
            "inputs": {
              "from": "@body('Transform_Chunk_To_Objects')",
              "format": "CSV"
            },
            "runAfter": {
              "Transform_Chunk_To_Objects": [
                "Succeeded"
              ]
            }
          },
          "Delete_Existing_Blob": {
            "type": "ApiConnection",
            "description": "Delete existing blob if present (to allow overwrite).",
            "inputs": {
              "host": {
                "connection": {
                  "referenceName": "azureblob"
                }
              },
              "method": "delete",
              "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(concat('https://', appsetting('REPORT_STORAGE_ACCOUNT_NAME'), '.blob.core.windows.net/')))}/files/@{encodeURIComponent(encodeURIComponent(concat('reportoutput/', items('Process_Time_Chunks')['blobName'])))}"
            },
            "runAfter": {
              "Create_Chunk_CSV": [
                "Succeeded"
              ]
            }
          },
          "Write_Chunk_Blob": {
            "type": "ApiConnection",
            "description": "Write this chunk's CSV to blob storage.",
            "inputs": {
              "host": {
                "connection": {
                  "referenceName": "azureblob"
                }
              },
              "method": "post",
              "body": "@body('Create_Chunk_CSV')",
              "headers": {
                "ReadFileMetadataFromServer": true
              },
              "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(concat('https://', appsetting('REPORT_STORAGE_ACCOUNT_NAME'), '.blob.core.windows.net/')))}/files",
              "queries": {
                "folderPath": "reportoutput",
                "name": "@{items('Process_Time_Chunks')['blobName']}",
                "queryParametersSingleEncoded": true
              }
            },
            "runAfter": {
              "Delete_Existing_Blob": [
                "Succeeded",
                "Failed"
              ]
            },
            "runtimeConfiguration": {
              "contentTransfer": {
                "transferMode": "Chunked"
              }
            }
          }
        },
        "runAfter": {
          "Initialize_Time_Chunks": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        }
      },
      "Handle_Query_Failure": {
        "type": "Http",
        "inputs": {
          "uri": "https://dce-chargeback-tvn4e57jpmg4q-cbbr.eastus2-1.ingest.monitor.azure.com/dataCollectionRules/dcr-7f17b77d08b54df991666d73380136e0/streams/Custom-WorkflowFailuresStream?api-version=2023-01-01",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": [
            {
              "TimeGenerated": "@{utcNow()}",
              "WorkflowName": "@{workflow().name}",
              "WorkflowRunId": "@{workflow().run.id}",
              "FailureType": "QueryFailure",
              "ActionName": "Process_Time_Chunks",
              "ErrorCode": "ChunkQueryFailure",
              "ErrorMessage": "One or more time chunk queries failed during execution.",
              "Severity": "High",
              "BlobPath": ""
            }
          ],
          "authentication": {
            "type": "ManagedServiceIdentity",
            "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
            "audience": "https://monitor.azure.com"
          }
        },
        "runAfter": {
          "Process_Time_Chunks": [
            "Failed"
          ]
        }
      },
      "Handle_Blob_Write_Failure": {
        "type": "Http",
        "inputs": {
          "uri": "https://dce-chargeback-tvn4e57jpmg4q-cbbr.eastus2-1.ingest.monitor.azure.com/dataCollectionRules/dcr-7f17b77d08b54df991666d73380136e0/streams/Custom-WorkflowFailuresStream?api-version=2023-01-01",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": [
            {
              "TimeGenerated": "@{utcNow()}",
              "WorkflowName": "@{workflow().name}",
              "WorkflowRunId": "@{workflow().run.id}",
              "FailureType": "BlobWriteFailure",
              "ActionName": "Write_Chunk_Blob",
              "ErrorCode": "BlobWriteError",
              "ErrorMessage": "Failed to write one or more chunk blobs.",
              "Severity": "High",
              "BlobPath": "reportoutput/"
            }
          ],
          "authentication": {
            "type": "ManagedServiceIdentity",
            "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
            "audience": "https://monitor.azure.com"
          }
        },
        "runAfter": {
          "Process_Time_Chunks": [
            "Succeeded",
            "Failed"
          ]
        }
      }
    }
  },
  "kind": "Stateful"
}
