∩╗┐{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "description": "Trigger generation of report daily",
        "recurrence": {
          "interval": 24,
          "frequency": "Hour",
          "timeZone": "Central Standard Time"
        }
      }
    },
    "actions": {
      "Initialize_Time_Chunks": {
        "type": "InitializeVariable",
        "description": "Create 12 x 2-hour time chunks to avoid memory limits on large datasets. Each chunk has hoursAgo (start) and hoursUntil (end) relative to now.",
        "inputs": {
          "variables": [
            {
              "name": "TimeChunks",
              "type": "array",
              "value": [
                { "chunkId": 1, "hoursAgo": 24, "hoursUntil": 22, "label": "21:00-23:00" },
                { "chunkId": 2, "hoursAgo": 22, "hoursUntil": 20, "label": "23:00-01:00" },
                { "chunkId": 3, "hoursAgo": 20, "hoursUntil": 18, "label": "01:00-03:00" },
                { "chunkId": 4, "hoursAgo": 18, "hoursUntil": 16, "label": "03:00-05:00" },
                { "chunkId": 5, "hoursAgo": 16, "hoursUntil": 14, "label": "05:00-07:00" },
                { "chunkId": 6, "hoursAgo": 14, "hoursUntil": 12, "label": "07:00-09:00" },
                { "chunkId": 7, "hoursAgo": 12, "hoursUntil": 10, "label": "09:00-11:00" },
                { "chunkId": 8, "hoursAgo": 10, "hoursUntil": 8, "label": "11:00-13:00" },
                { "chunkId": 9, "hoursAgo": 8, "hoursUntil": 6, "label": "13:00-15:00" },
                { "chunkId": 10, "hoursAgo": 6, "hoursUntil": 4, "label": "15:00-17:00" },
                { "chunkId": 11, "hoursAgo": 4, "hoursUntil": 2, "label": "17:00-19:00" },
                { "chunkId": 12, "hoursAgo": 2, "hoursUntil": 0, "label": "19:00-21:00" }
              ]
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_All_Results": {
        "type": "InitializeVariable",
        "description": "Array to collect all rows from all time chunk queries.",
        "inputs": {
          "variables": [
            {
              "name": "AllResults",
              "type": "array",
              "value": []
            }
          ]
        },
        "runAfter": {
          "Initialize_Time_Chunks": [
            "Succeeded"
          ]
        }
      },
      "Initialize_Aggregated_Data": {
        "type": "InitializeVariable",
        "description": "Object to store aggregated rows by composite key.",
        "inputs": {
          "variables": [
            {
              "name": "AggregatedData",
              "type": "object",
              "value": {}
            }
          ]
        },
        "runAfter": {
          "Initialize_All_Results": [
            "Succeeded"
          ]
        }
      },
      "Initialize_Seen_Keys": {
        "type": "InitializeVariable",
        "description": "Array to track unique composite keys for aggregation.",
        "inputs": {
          "variables": [
            {
              "name": "SeenKeys",
              "type": "array",
              "value": []
            }
          ]
        },
        "runAfter": {
          "Initialize_Aggregated_Data": [
            "Succeeded"
          ]
        }
      },
      "Initialize_Final_Results": {
        "type": "InitializeVariable",
        "description": "Array to collect final aggregated rows for CSV.",
        "inputs": {
          "variables": [
            {
              "name": "FinalResults",
              "type": "array",
              "value": []
            }
          ]
        },
        "runAfter": {
          "Initialize_Seen_Keys": [
            "Succeeded"
          ]
        }
      },
      "Process_Time_Chunks": {
        "type": "Foreach",
        "description": "Iterate through each 4-hour time chunk and execute the query. Runs sequentially to avoid overwhelming Log Analytics.",
        "foreach": "@variables('TimeChunks')",
        "actions": {
          "Submit_Chunk_Query": {
            "type": "Http",
            "description": "Submit the Log Analytics query for this time chunk asynchronously.",
            "inputs": {
              "uri": "https://api.loganalytics.io/v1/workspaces/@{appsetting('LOG_ANALYTICS_WORKSPACE_ID')}/query",
              "method": "POST",
              "headers": {
                "Content-Type": "application/json",
                "Prefer": "wait=0"
              },
              "body": {
                "query": "let reportEnd = datetime_add('hour', @{int(appsetting('REPORT_END_HOUR'))}, startofday(now() - 1d)); let chunkStart = datetime_add('hour', -@{items('Process_Time_Chunks')['hoursAgo']}, reportEnd); let chunkEnd = datetime_add('hour', -@{items('Process_Time_Chunks')['hoursUntil']}, reportEnd); let llmAgg = ApiManagementGatewayLlmLog | where TimeGenerated >= chunkStart and TimeGenerated < chunkEnd | where SequenceNumber == 0 | summarize TotalTokens = sum(TotalTokens), CompletionTokens = sum(CompletionTokens), PromptTokens = sum(PromptTokens) by CorrelationId; ApiManagementGatewayLogs | where TimeGenerated >= chunkStart and TimeGenerated < chunkEnd | where IsRequestSuccess | join hint.strategy=shuffle kind=inner llmAgg on CorrelationId | extend ParsedUrl = parse_url(BackendUrl) | extend ExtractedEndpoint = strcat(tostring(ParsedUrl.Scheme), '://', tostring(ParsedUrl.Host), '/') | extend DeploymentFromUrl = extract('/openai/deployments/([^/]+)/', 1, BackendUrl) | extend Luma = extract('^([0-9]{6})', 1, ApimSubscriptionId), Workspace = extract('^[0-9]{6}-(.+)$', 1, ApimSubscriptionId) | join kind=leftouter (CognitiveServicesInventory_CL | summarize arg_max(TimeGenerated, *) by AccountEndpoint, DeploymentName | project AccountEndpoint, CogSvcDeploymentName = DeploymentName, CogSvcModelName = ModelName, CogSvcSkuName = SkuName, CogSvcSkuCapacity = SkuCapacity, CogSvcAccountName = AccountName, CogSvcSubscriptionId = SubscriptionId) on $left.ExtractedEndpoint == $right.AccountEndpoint, $left.DeploymentFromUrl == $right.CogSvcDeploymentName | summarize TotalTokens = sum(TotalTokens), CompletionTokens = sum(CompletionTokens), PromptTokens = sum(PromptTokens), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Regions = strcat_array(make_set(Region, 8), '; '), CallerIpAddresses = strcat_array(make_set(CallerIpAddress, 8), '; '), Calls = count() by ProductId, DeploymentFromUrl, ExtractedEndpoint, BackendId, CogSvcModelName, CogSvcSkuName, CogSvcSkuCapacity, CogSvcAccountName, CogSvcSubscriptionId, Luma, Workspace | project ProductId, Luma, Workspace, DeploymentName = DeploymentFromUrl, ModelName = CogSvcModelName, AccountName = CogSvcAccountName, SubscriptionId = CogSvcSubscriptionId, SkuName = CogSvcSkuName, SkuCapacity = CogSvcSkuCapacity, BackendId, Endpoint = ExtractedEndpoint, PromptTokens, CompletionTokens, TotalTokens, Calls, FirstSeen, LastSeen, Regions, CallerIpAddresses | order by ProductId asc, TotalTokens desc"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
                "audience": "https://api.loganalytics.io"
              }
            },
            "runAfter": {},
            "runtimeConfiguration": {
              "contentTransfer": {
                "transferMode": "Chunked"
              }
            }
          },
          "Check_Chunk_Sync_Or_Async": {
            "type": "If",
            "description": "If 200, query completed synchronously. If 202, poll for results.",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@outputs('Submit_Chunk_Query')['statusCode']",
                    200
                  ]
                }
              ]
            },
            "actions": {
              "Set_Chunk_Sync_Results": {
                "type": "Compose",
                "inputs": "@body('Submit_Chunk_Query')"
              }
            },
            "else": {
              "actions": {
                "Get_Poll_Location": {
                  "type": "Compose",
                  "inputs": "@outputs('Submit_Chunk_Query')['headers']?['location']",
                  "runAfter": {}
                },
                "Wait_Before_Poll": {
                  "type": "Wait",
                  "inputs": {
                    "interval": {
                      "count": 10,
                      "unit": "Second"
                    }
                  },
                  "runAfter": {
                    "Get_Poll_Location": [
                      "Succeeded"
                    ]
                  }
                },
                "Poll_Chunk_Results": {
                  "type": "Until",
                  "description": "Poll until query completes or timeout.",
                  "expression": "@equals(outputs('Check_Chunk_Status')['statusCode'], 200)",
                  "limit": {
                    "count": 60,
                    "timeout": "PT15M"
                  },
                  "actions": {
                    "Check_Chunk_Status": {
                      "type": "Http",
                      "inputs": {
                        "uri": "@{outputs('Get_Poll_Location')}",
                        "method": "GET",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
                          "audience": "https://api.loganalytics.io"
                        }
                      },
                      "runAfter": {}
                    },
                    "Delay_Chunk_Poll": {
                      "type": "Wait",
                      "inputs": {
                        "interval": {
                          "count": 15,
                          "unit": "Second"
                        }
                      },
                      "runAfter": {
                        "Check_Chunk_Status": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Wait_Before_Poll": [
                      "Succeeded"
                    ]
                  }
                },
                "Set_Chunk_Async_Results": {
                  "type": "Compose",
                  "inputs": "@body('Check_Chunk_Status')",
                  "runAfter": {
                    "Poll_Chunk_Results": [
                      "Succeeded"
                    ]
                  }
                }
              }
            },
            "runAfter": {
              "Submit_Chunk_Query": [
                "Succeeded"
              ]
            }
          },
          "Get_Chunk_Results": {
            "type": "Compose",
            "description": "Get the final results for this chunk.",
            "inputs": "@if(equals(outputs('Submit_Chunk_Query')['statusCode'], 200), outputs('Set_Chunk_Sync_Results'), outputs('Set_Chunk_Async_Results'))",
            "runAfter": {
              "Check_Chunk_Sync_Or_Async": [
                "Succeeded"
              ]
            }
          },
          "Transform_Chunk_To_Objects": {
            "type": "Select",
            "description": "Transform each row array to a named object.",
            "inputs": {
              "from": "@if(equals(outputs('Get_Chunk_Results')?['tables']?[0]?['rows'], null), json('[]'), outputs('Get_Chunk_Results')?['tables']?[0]?['rows'])",
              "select": {
                "ProductId": "@item()[0]",
                "Luma": "@item()[1]",
                "Workspace": "@item()[2]",
                "DeploymentName": "@item()[3]",
                "ModelName": "@item()[4]",
                "AccountName": "@item()[5]",
                "SubscriptionId": "@item()[6]",
                "SkuName": "@item()[7]",
                "SkuCapacity": "@item()[8]",
                "BackendId": "@item()[9]",
                "Endpoint": "@item()[10]",
                "PromptTokens": "@item()[11]",
                "CompletionTokens": "@item()[12]",
                "TotalTokens": "@item()[13]",
                "Calls": "@item()[14]",
                "FirstSeen": "@item()[15]",
                "LastSeen": "@item()[16]",
                "Regions": "@item()[17]",
                "CallerIpAddresses": "@item()[18]"
              }
            },
            "runAfter": {
              "Get_Chunk_Results": [
                "Succeeded"
              ]
            }
          },
          "Merge_Chunk_Data": {
            "type": "SetVariable",
            "description": "Merge this chunk's rows into AllResults using union().",
            "inputs": {
              "name": "AllResults",
              "value": "@union(variables('AllResults'), body('Transform_Chunk_To_Objects'))"
            },
            "runAfter": {
              "Transform_Chunk_To_Objects": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_Final_Results": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        }
      },
      "Aggregate_All_Results": {
        "type": "Foreach",
        "description": "Aggregate rows by composite key (ProductId|Deployment|Endpoint etc.), summing tokens and calls.",
        "foreach": "@variables('AllResults')",
        "actions": {
          "Build_Composite_Key": {
            "type": "Compose",
            "inputs": "@concat(coalesce(items('Aggregate_All_Results')['ProductId'], ''), '|', coalesce(items('Aggregate_All_Results')['Luma'], ''), '|', coalesce(items('Aggregate_All_Results')['Workspace'], ''), '|', coalesce(items('Aggregate_All_Results')['DeploymentName'], ''), '|', coalesce(items('Aggregate_All_Results')['ModelName'], ''), '|', coalesce(items('Aggregate_All_Results')['AccountName'], ''), '|', coalesce(items('Aggregate_All_Results')['SubscriptionId'], ''), '|', coalesce(items('Aggregate_All_Results')['BackendId'], ''), '|', coalesce(items('Aggregate_All_Results')['Endpoint'], ''), '|', coalesce(items('Aggregate_All_Results')['SkuName'], ''), '|', coalesce(string(items('Aggregate_All_Results')['SkuCapacity']), ''))"
          },
          "Check_Key_Exists": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "contains": [
                    "@variables('SeenKeys')",
                    "@outputs('Build_Composite_Key')"
                  ]
                }
              ]
            },
            "actions": {
              "Update_Existing_Row": {
                "type": "SetVariable",
                "inputs": {
                  "name": "AggregatedData",
                  "value": "@setProperty(variables('AggregatedData'), outputs('Build_Composite_Key'), json(concat('{\"ProductId\":\"', coalesce(items('Aggregate_All_Results')['ProductId'], ''), '\",\"Luma\":\"', coalesce(items('Aggregate_All_Results')['Luma'], ''), '\",\"Workspace\":\"', coalesce(items('Aggregate_All_Results')['Workspace'], ''), '\",\"DeploymentName\":\"', coalesce(items('Aggregate_All_Results')['DeploymentName'], ''), '\",\"ModelName\":\"', coalesce(items('Aggregate_All_Results')['ModelName'], ''), '\",\"AccountName\":\"', coalesce(items('Aggregate_All_Results')['AccountName'], ''), '\",\"SubscriptionId\":\"', coalesce(items('Aggregate_All_Results')['SubscriptionId'], ''), '\",\"SkuName\":\"', coalesce(items('Aggregate_All_Results')['SkuName'], ''), '\",\"SkuCapacity\":', coalesce(string(items('Aggregate_All_Results')['SkuCapacity']), 'null'), ',\"BackendId\":\"', coalesce(items('Aggregate_All_Results')['BackendId'], ''), '\",\"Endpoint\":\"', coalesce(items('Aggregate_All_Results')['Endpoint'], ''), '\",\"PromptTokens\":', string(add(int(coalesce(variables('AggregatedData')[outputs('Build_Composite_Key')]?['PromptTokens'], 0)), int(coalesce(items('Aggregate_All_Results')['PromptTokens'], 0)))), ',\"CompletionTokens\":', string(add(int(coalesce(variables('AggregatedData')[outputs('Build_Composite_Key')]?['CompletionTokens'], 0)), int(coalesce(items('Aggregate_All_Results')['CompletionTokens'], 0)))), ',\"TotalTokens\":', string(add(int(coalesce(variables('AggregatedData')[outputs('Build_Composite_Key')]?['TotalTokens'], 0)), int(coalesce(items('Aggregate_All_Results')['TotalTokens'], 0)))), ',\"Calls\":', string(add(int(coalesce(variables('AggregatedData')[outputs('Build_Composite_Key')]?['Calls'], 0)), int(coalesce(items('Aggregate_All_Results')['Calls'], 0)))), ',\"FirstSeen\":\"', if(less(ticks(coalesce(items('Aggregate_All_Results')['FirstSeen'], '9999-12-31T23:59:59Z')), ticks(coalesce(variables('AggregatedData')[outputs('Build_Composite_Key')]?['FirstSeen'], '9999-12-31T23:59:59Z'))), items('Aggregate_All_Results')['FirstSeen'], variables('AggregatedData')[outputs('Build_Composite_Key')]?['FirstSeen']), '\",\"LastSeen\":\"', if(greater(ticks(coalesce(items('Aggregate_All_Results')['LastSeen'], '0001-01-01T00:00:00Z')), ticks(coalesce(variables('AggregatedData')[outputs('Build_Composite_Key')]?['LastSeen'], '0001-01-01T00:00:00Z'))), items('Aggregate_All_Results')['LastSeen'], variables('AggregatedData')[outputs('Build_Composite_Key')]?['LastSeen']), '\",\"Regions\":\"', coalesce(items('Aggregate_All_Results')['Regions'], ''), '\",\"CallerIpAddresses\":\"', coalesce(items('Aggregate_All_Results')['CallerIpAddresses'], ''), '\"}')))"
                }
              }
            },
            "else": {
              "actions": {
                "Add_New_Key": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "SeenKeys",
                    "value": "@outputs('Build_Composite_Key')"
                  }
                },
                "Add_New_Row": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "AggregatedData",
                    "value": "@setProperty(variables('AggregatedData'), outputs('Build_Composite_Key'), items('Aggregate_All_Results'))"
                  },
                  "runAfter": {
                    "Add_New_Key": [
                      "Succeeded"
                    ]
                  }
                }
              }
            },
            "runAfter": {
              "Build_Composite_Key": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Process_Time_Chunks": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        }
      },
      "Build_Final_Array": {
        "type": "Foreach",
        "description": "Convert aggregated object to array for CSV generation.",
        "foreach": "@variables('SeenKeys')",
        "actions": {
          "Append_Aggregated_Row": {
            "type": "AppendToArrayVariable",
            "inputs": {
              "name": "FinalResults",
              "value": "@variables('AggregatedData')[items('Build_Final_Array')]"
            }
          }
        },
        "runAfter": {
          "Aggregate_All_Results": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        }
      },
      "Create_blob_(V2)": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "azureblob"
            }
          },
          "method": "post",
          "body": "@body('Create_CSV_table')",
          "headers": {
            "ReadFileMetadataFromServer": true
          },
          "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(concat('https://', appsetting('REPORT_STORAGE_ACCOUNT_NAME'), '.blob.core.windows.net/')))}/files",
          "queries": {
            "folderPath": "reportoutput",
            "name": "dailyChargeBackReport.csv",
            "queryParametersSingleEncoded": true
          }
        },
        "runAfter": {
          "Create_CSV_table": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "contentTransfer": {
            "transferMode": "Chunked"
          }
        }
      },
      "Create_CSV_table": {
        "type": "Table",
        "inputs": {
          "from": "@variables('FinalResults')",
          "format": "CSV"
        },
        "runAfter": {
          "Build_Final_Array": [
            "Succeeded"
          ]
        }
      },
      "Handle_Query_Failure": {
        "type": "Http",
        "inputs": {
          "uri": "https://dce-chargeback-tvn4e57jpmg4q-cbbr.eastus2-1.ingest.monitor.azure.com/dataCollectionRules/dcr-7f17b77d08b54df991666d73380136e0/streams/Custom-WorkflowFailuresStream?api-version=2023-01-01",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": [
            {
              "TimeGenerated": "@{utcNow()}",
              "WorkflowName": "@{workflow().name}",
              "WorkflowRunId": "@{workflow().run.id}",
              "FailureType": "QueryFailure",
              "ActionName": "Process_Time_Chunks",
              "ErrorCode": "ChunkQueryFailure",
              "ErrorMessage": "One or more time chunk queries failed during execution.",
              "Severity": "High",
              "BlobPath": ""
            }
          ],
          "authentication": {
            "type": "ManagedServiceIdentity",
            "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
            "audience": "https://monitor.azure.com"
          }
        },
        "runAfter": {
          "Process_Time_Chunks": [
            "TimedOut",
            "Failed"
          ]
        }
      },
      "Handle_Blob_Write_Failure": {
        "type": "Http",
        "inputs": {
          "uri": "https://dce-chargeback-tvn4e57jpmg4q-cbbr.eastus2-1.ingest.monitor.azure.com/dataCollectionRules/dcr-7f17b77d08b54df991666d73380136e0/streams/Custom-WorkflowFailuresStream?api-version=2023-01-01",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": [
            {
              "TimeGenerated": "@{utcNow()}",
              "WorkflowName": "@{workflow().name}",
              "WorkflowRunId": "@{workflow().run.id}",
              "FailureType": "BlobWriteFailure",
              "ActionName": "Create_blob_(V2)",
              "BlobPath": "reportoutput/dailyChargeBackReport.csv",
              "ErrorCode": "@{actions('Create_blob_(V2)')?['error']?['code']}",
              "ErrorMessage": "@{actions('Create_blob_(V2)')?['error']?['message']}",
              "Severity": "High"
            }
          ],
          "authentication": {
            "type": "ManagedServiceIdentity",
            "identity": "/subscriptions/b5b4a11b-5367-41d2-9ec2-fee75c17c5f9/resourceGroups/PTUChargeBackChunks/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-chargeback-tvn4e57jpmg4q",
            "audience": "https://monitor.azure.com"
          }
        },
        "runAfter": {
          "Create_blob_(V2)": [
            "TimedOut",
            "Skipped",
            "Failed"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "stateful"
}




















